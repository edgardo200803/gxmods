suma = 0
contador = 0

while True:
    calificacion = float(input("Ingresa una calificación (0 a 10): "))

    if 0 <= calificacion <= 10:
        suma += calificacion
        contador += 1
    else:
        break

if contador > 0:
    promedio = suma / contador
    print("El promedio es:", promedio)
else:
    print("No se ingresaron calificaciones válidas")
